{
  "name": "nova-pdf-studio",
  "productName": "NOVA PDF Studio",
  "version": "0.1.0",
  "description": "PDF Editor - Smart Invoice - Spreadsheet - Documents",
  "main": "./out/main/index.js",
  "author": "NOVA",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "winner": "node server.js",
    "winner:dev": "NODE_ENV=development node server.js"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "csv-stringify": "^6.8.3",
    "dotenv": "^18.0.1",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "i18next": "^24.2.0",
    "lucide-react": "^0.475.0",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.0",
    "sql.js": "^1.12.0",
    "sqlite3": "^6.0.1",
    "tesseract.js": "^5.1.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.4"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true,
    "tesseract.js@5.1.1": true
  },
  "homepage": "https://github.com/ohaigoune-debug/nova-pdf-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/ohaigoune-debug/nova-pdf-studio.git"
  },
  "bugs": {
    "url": "https://github.com/ohaigoune-debug/nova-pdf-studio/issues"
  }
}
