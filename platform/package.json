  "private": true,
  "description": "منصة تعليمية عربية متعددة الأساتذة: أفواج، حضور ذكي، واجبات، تصحيح بالذكاء الاصطناعي",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
