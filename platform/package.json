    "db:bootstrap": "tsx src/server/db/bootstrap.ts",
    "db:reset": "tsx src/server/db/reset.ts",
    "db:rls": "tsx src/server/db/apply-rls.ts",
    "jobs:worker": "tsx src/server/jobs/worker.ts",
    "push:keys": "tsx src/server/lib/web-push-keys.ts",
    "build:standalone": "NEXT_OUTPUT=standalone next build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
