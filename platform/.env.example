# قاعدة البيانات
# محلياً بلا خادم (PGlite يحفظ في ./data/pglite):  pglite://./data/pglite
# في الإنتاج (Supabase/Neon/RDS):  postgres://user:pass@host:5432/dbname
DATABASE_URL=pglite://./data/pglite

# أسرار (أنشئها بـ:  openssl rand -base64 48 )
SESSION_SECRET=change-me-session-secret
QR_TOKEN_SECRET=change-me-qr-secret

# عمر رمز الحضور بالثواني ومدة التجديد في المتصفح
QR_TOKEN_TTL_SECONDS=60

# عنوان التطبيق (للروابط في الإشعارات)
APP_URL=http://localhost:3000

# الذكاء الاصطناعي (المرحلة 6) — لا تُعرض للمتصفح أبداً
AI_PROVIDER=mock
AI_API_KEY=
# AI_PROVIDER=anthropic يتطلب AI_API_KEY؛ AI_MODEL اختياري (افتراضي claude-sonnet-5)
AI_MODEL=

# المهام الخلفية: العامل الداخلي يعمل تلقائياً داخل الخادم (JOBS_INLINE_WORKER=0 لتعطيله واستعمال cron/worker خارجي)
# سرّ تشغيل العامل من Cron خارجي:  POST /api/v1/jobs/run  مع الترويسة x-cron-secret
CRON_SECRET=
JOBS_INLINE_WORKER=1
