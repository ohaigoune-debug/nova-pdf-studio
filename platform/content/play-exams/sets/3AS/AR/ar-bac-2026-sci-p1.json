       "1-",
       "\"أوراسُ\" يـا أَطْوادَ عِزٍّ شـــامِخٍ",
       "المجـدُ آبَ إلى رِحـابِـكَ و(ارْتَمَى)"
      ],
      [
       "2-",
       "العِـــزُّ أنتَ أَثِيلُــه وتَليــــدُه",
       "مهْمـــا رَمـاكَ الدّهرُ فيمَـا قَدْ رَمى"
      ],
      [
       "3-",
       "يا ســـامِقًا كالنّسْـــرِ في عَلْيَائِه",
       "أَعْيَـتْ ذُراهُ الواصِــفَ المُتَكلِّمَـا"
      ],
      [
       "4-",
       "هـلْ أنــتَ إلَّا ثـورة عــربـيَّـة",
       "زَحَفتْ لِتُوقِظَ بالرَّصـــاص النُّوَّمَا؟!"
