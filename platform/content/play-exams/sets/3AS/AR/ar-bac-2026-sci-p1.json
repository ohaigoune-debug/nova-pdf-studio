      ],
      [
       "7-",
       "ما خابَ إِذْ ضَـحَّى لأجلِكَ واقْتَدى",
       "شِــبْـلٌ أَبَرُّ إلى مَعـاقِلِـكَ انْتَمَى"
      ],
      [
       "8-",
       "ما خابَ مَنْ ضَـحَّى لأجْل مَعَاقِلٍ",
