     "kind": "table",
     "caption": "الأبيات",
     "table": [
      [
       "1-",
       "أقبل العيـد ولـكـن",
       "ليس في النَّاس الـمــسره"
      ],
      [
       "2-",
       "لا أرى إلا وجُـوها",
       "كالحاتٍ مكـفـهـره"
      ],
      [
       "3-",
       "وخـدودًا باهــــــتــــــاتٍ",
       "قد كساها الهمُّ صُـفـره"
      ],
      [
       "4-",
       "ليس للقـوم حـديـثٌ",
       "غير شكوى مُستمـره"
      ],
      [
       "5-",
       "لا تسـل ماذا عَراهـم",
       "كلُّهـم يـجهل أمـــــــره"
      ],
      [
       "6-",
       "كلُّهم يبكي على الأمــــــــــــــــــــــــــــــــــــــــــس",
       "ويخشى شـرَّ بــُـكـــرهُ"
      ],
      [
       "7-",
       "فهم مثـل عـــجوزٍ",
       "فقدت في البحر إبـره"
      ],
      [
       "8-",
       "أيُّها الشاكي الليـالي",
       "إنَّما الغبطـةُ فِـكــره"
      ],
      [
       "9-",
       "تلمسُ الغصن الـمُعرَّى",
       "فإذا في الغصـن نُضُره"
      ],
      [
       "10-",
       "وإذا رفت على القفــــــــــــــــــــــــر",
       "استوى مـاء وخُـضـره"
      ],
      [
       "11-",
       "أيُّها العابس لن تُعـــــــــــــــــــــــــــــطى",
       "على التقطيب أُجـــــرة"
      ],
      [
       "12-",
       "لا تكن مـرًّا ولا تجــــــــــــــــــــــــــــــــــعــــــل",
       "حيـاة الغيـر مُـــــــرَّه"
      ],
      [
       "13-",
       "فتهلَّل وتــــرنــَّــــــم",
       "فالفـتى العابـس صـخـرَه"
