 "original_questions": [
  {
   "id": "q1",
   "number": "1",
   "part": "أوّلا- البناء الفكري: (10 نقاط)",
   "verbatim_text": "ما الذي زار الشاعر؟ وعمَّ يدل ذلك؟",
   "documents": [
    {
     "id": "d-intro",
     "kind": "text",
     "caption": "تقديم النّصّ",
     "text": "قال البارودي:"
    },
    {
     "id": "d-poem",
     "kind": "table",
     "caption": "الأبيات",
     "table": [
      [
       "1-",
       "تأوّب طيف من \" سميـرة \" زائـر",
       "وما الطّيف إلاّ ما تُريـه الخواطـر"
      ],
      [
       "2-",
       "طوى سدفة الظلماء و(الليل ضارب)",
       "بأرواقه والنجـم بالأفـق حـائـر"
      ],
      [
       "3-",
       "فيـا لك من طيـف ألـم ودونه",
       "محيـط من البحر الجنوبيّ زاخـر"
      ],
      [
       "4-",
       "تخطّى إليّ الأرض وجدا ومـا لـه",
       "سوى نزوات الشوق حادٍ وزاجر"
      ],
      [
       "5-",
       "ألـم ولم يلبـث وسـار ولَيْـته",
       "أقـام ولو طالت علىّ الدياجـر"
      ],
      [
       "6-",
       "فيـا بعـد ما بيني وبين أحبّـتي",
       "ويا قرب ما (التفت عليه الضمائر)"
      ],
      [
       "7-",
       "ولولا أمـاني النفس وهي حياتها",
       "لما طـار لي فوق البسيطة طائـر"
      ],
      [
       "8-",
       "فإن تكـن الأيـام فرّقن بينــنا",
       "فكلُّ امرئ يوما إلى الله صـائـر"
      ],
      [
       "9-",
       "صبرت على كره لمـا قد أصابني",
       "ومن لم يجد مندوحة فهو صابـر"
      ],
      [
       "10-",
       "وما الحِلم عند الخطب والمرء عاجز",
       "بمستحسن كالحِلم والمرء قـادر"
      ],
      [
       "11-",
       "ولكن إذا قلَّ النَّصيـر وأعوزت",
       "دواعي المنى (فالصّبـر فيه المعـاذر)"
      ]
     ]
    }
   ],
   "rubric_total": 1.5,
   "rubric_elements": [
    {
     "id": "q1-e1",
     "label": "زائر الشّاعر ودلالة الزّيارة",
     "max_points": 1.5,
     "verified": false
    }
   ]
  },
