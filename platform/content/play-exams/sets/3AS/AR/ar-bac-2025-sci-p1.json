      [
       "09-",
       "وصَرَخْنَ في وجْهِ العَميـ",
       "ـدِ، وحقُّهُـنَّ لَهُـنّ حـارسْ"
      ],
      [
       "10-",
       "وطَني، ظَفِرْتَ إذا النّسا",
       "ءُ هَتفْـنَ باسْمِكَ في المَجالسْ"
      ],
      [
       "11-",
       "وطَني، عَلَيْنا العهدُ جَمْـ",
       "ـعًا أنْ نَسيـرَ إلى الأمـامِ"
      ],
      [
       "12-",
       "ولَـرُدّ عنْـكَ النّـازِلا",
       "تِ، مُسابِقيـنَ إلى الحِمـامِ"
