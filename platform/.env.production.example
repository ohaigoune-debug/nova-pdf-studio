# إعداد الإنتاج على خادم VPS — انسخه إلى .env بجوار docker-compose.prod.yml
# أنشئ كل سرّ بـ:  openssl rand -base64 48

# ── النطاق ────────────────────────────────────────────────────────────────
# Caddy يصدر شهادة TLS لهذه النطاقات تلقائياً. أضف madrasa.dz حين يجهز:
#   SITE_ADDRESS=madrasadz.com, www.madrasadz.com, madrasa.dz, www.madrasa.dz
SITE_ADDRESS=madrasadz.com, www.madrasadz.com
APP_URL=https://madrasadz.com

# ── الأسرار ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
SESSION_SECRET=
QR_TOKEN_SECRET=
CRON_SECRET=

# ── أول مشرف (يُنشأ مرة واحدة عند أول نشر) ─────────────────────────────────
# 12 حرفاً على الأقل. النشر اللاحق لا يغيّر كلمة السر هذه.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ── تطبيق أندرويد ─────────────────────────────────────────────────────────
# بصمة SHA-256 من بناء التطبيق. بعد أول رفع على Play أضف بصمة Play بفاصلة.
ANDROID_PACKAGE_NAME=dz.madrasa.app
ANDROID_CERT_FINGERPRINTS=

# ── الذكاء الاصطناعي ──────────────────────────────────────────────────────
# mock = بلا تكلفة. anthropic أو openai = تصحيح وتنظيم حقيقيان
# (انظر docs/DEPLOYMENT.md للتكلفة). الدفعات بنصف السعر متاحة مع anthropic فقط.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
# openai فقط: خادم متوافق بدل api.openai.com
AI_BASE_URL=

# ── يوتيوب ────────────────────────────────────────────────────────────────
# اختياري: مفتاح YouTube Data API v3 لاستيراد قوائم التشغيل كاملة.
# بدونه تُقرأ آخر ١٥ فيديو فقط من كل قائمة (تغذية RSS العامة).
YOUTUBE_API_KEY=

# ── البريد (إعادة تعيين كلمة السر) ────────────────────────────────────────
MAIL_PROVIDER=console
MAIL_API_KEY=
MAIL_FROM="مدرسة <no-reply@madrasadz.com>"

# ── التخزين ───────────────────────────────────────────────────────────────
# local = قرص الخادم (volume دائم). s3 = Cloudflare R2 وما شابه للفيديوهات.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── النسخ الاحتياطي ───────────────────────────────────────────────────────
# يُكتب في ./backups عند كل إقلاع ثم كل BACKUP_INTERVAL_HOURS ساعة.
# انسخه خارج الخادم: نسخة على نفس القرص لا تحميك من تلف القرص.
BACKUP_KEEP=14
BACKUP_INTERVAL_HOURS=24

# ── إشعارات الدفع ─────────────────────────────────────────────────────────
# ولّدها بـ: npm run push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@madrasadz.com
